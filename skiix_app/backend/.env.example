BASE_URL=http://localhost:8080
PORT=8080
APP_ENV=development
LOG_LEVEL=INFO

# --- Redis (rate limiting; optional in dev — fails open if unreachable) ---
REDIS_URL=redis://localhost:6379
RATE_LIMIT_GLOBAL_RPM=100
RATE_LIMIT_AUTH_RPM=5

# --- Observability (optional) ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
APP_VERSION=dev

# --- CORS (comma-separated origins; Expo web / admin) ---
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Graceful shutdown timeout (seconds)
SHUTDOWN_TIMEOUT_SECONDS=10

# --- Database (Supabase pooler recommended) ---
# Dashboard → Connect → Session pooler → copy URI
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Fallback if DATABASE_URL is empty
DB_HOST=db.YOUR-PROJECT-REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=postgres
DB_SSLMODE=require

# --- Auth: three DIFFERENT values (do not reuse) ---
# Legacy browser OAuth / refresh tokens — generate: openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Supabase project URL — required for mobile JWT verification (JWKS / ES256)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Optional HS256 JWT secret — Dashboard → Settings → API → JWT Secret
# NOT the service role key (sb_secret_*)
SUPABASE_JWT_SECRET=

# Server-only — Dashboard → Settings → API → service_role (sb_secret_*)
# Used for OTP/signup admin calls ONLY
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# --- Email OTP (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Skiix <onboarding@resend.dev>
# Optional: sync waitlist signups to Resend audience
RESEND_AUDIENCE_ID=

# --- Admin (waitlist export) ---
ADMIN_API_KEY=

# --- Google OAuth (browser /auth/google only) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Firebase (push + RTDB chat token) — ADR-001 ---
# Download service account JSON from Firebase Console → Project settings → Service accounts
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- WaveSpeed LLM (AI assist) ---
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://llm.wavespeed.ai/v1
WAVESPEED_MODEL=bytedance-seed/seed-1.6-flash
WAVESPEED_FALLBACK_MODEL=bytedance-seed/seed-1.6-flash
