# Copy to .env or .env.local. Both are gitignored in common setups; prefer .env.local for local secrets.

# Expo (required for this React Native / Expo app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional — lib/supabase.ts also reads these (e.g. if you copy from Supabase + Next.js docs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Go API — leave empty in dev (auto-detects from Expo Metro IP). On device: http://YOUR_LAN_IP:8080
EXPO_PUBLIC_API_URL=

# Google OAuth only — leave UNSET for email OTP signup (6-digit code in app).
# Setting EXPO_PUBLIC_AUTH_REDIRECT_URL can trigger magic-link emails (avoid for OTP).
# EXPO_PUBLIC_AUTH_REDIRECT_URL=skiix://auth/callback

# Email signup: use Supabase Dashboard → Authentication → Email (built-in sender, Custom SMTP OFF).
# Email template "Confirm signup" should include {{ .Token }} for 6-digit OTP in the app.

# Web-only: origin when running Expo web (optional)
EXPO_PUBLIC_AUTH_REDIRECT_ORIGIN=
