# Copy to supabase/.env then: supabase secrets set --env-file supabase/.env
RESEND_API_KEY=re_your_resend_api_key
# From Dashboard → Authentication → Hooks → Send Email → generate secret
SEND_EMAIL_HOOK_SECRET=v1,whsec_your_hook_secret
# Must be a verified sender in Resend (domain skiix.com or onboarding@resend.dev for tests)
AUTH_EMAIL_FROM=Skiix <onboarding@resend.dev>
