# Copy to .env or .env.local. Both are gitignored in common setups; prefer .env.local for local secrets.

# Expo (required for this React Native / Expo app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional — lib/supabase.ts also reads these (e.g. if you copy from Supabase + Next.js docs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_API_URL=

# When testing Expo web on a device, set origin to your dev machine: http://192.168.x.x:8081
# (so email links are not http://localhost:... which the phone cannot reach)
EXPO_PUBLIC_AUTH_REDIRECT_ORIGIN=
