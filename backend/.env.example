BASE_URL=http://localhost:8080

# Local example (use DB_SSLMODE=disable)
#DB_HOST=localhost
#DB_PORT=5432
#DB_USER=postgres
#DB_PASSWORD=postgres_password
#DB_NAME=skiix_db
#DB_SSLMODE=disable

# Supabase (recommended, IPv4): Dashboard → Connect → "Shared pooler" / Session mode → copy URI. Overrides DB_*.
# Project ref in the user is: postgres.YOUR-PROJECT-REF  (e.g. postgres.snzhheiuysgjiracbpwj)
# Example (replace REGION and password; use your panel’s host, e.g. aws-1-ap-southeast-1):
# postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Only used if DATABASE_URL is empty (direct db host is often IPv6-only; prefer pooler above).
DB_HOST=db.YOUR-PROJECT-REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=postgres
DB_SSLMODE=require

JWT_SECRET=sk11x-b4ck3nd-s3cr3t
# Get these from Google Cloud Console (OAuth 2.0 Client IDs) — for server /auth/google (browser redirect)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Admin (optional): only for FCM push via backend — not used for app login (auth is Supabase)
# FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# Cloudinary (media uploads). Keep API secret on backend only.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
